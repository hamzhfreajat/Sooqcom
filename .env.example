# Address of the FastAPI backend (the same one the mobile app uses)
API_URL=https://api.sooq-com.com/api
# Public address of this website
NEXT_PUBLIC_SITE_URL=https://sooq-com.com
# Backend used for sign-in, smart search and posting (defaults to API_URL)
# ACCOUNT_API_URL=https://api.sooq-com.com/api
# Google OAuth web client ID. Its authorised JavaScript origins must include this site.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Search-engine ownership codes ("HTML tag" method): only the code, not the whole tag.
# Set them at build time and at run time. A DNS record works too and needs nothing here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Analytics 4 measurement id (G-XXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=
